INSERT INTO inspection_main_items (section_code, category, title_th, has_fail_items, order_no) VALUES
('1_1', 1, '1.1 ห้องเก็บรักษาสัตว์น้ำอยู่ในสภาพดี สะอาด มีขนาดเหมาะสมเพียงพอ', 1, 1),
('1_2', 1, '1.2 มีโครงสร้างอย่างเหมาะสมโดยมีซอกมุมน้อยที่สุด เพื่อให้ง่ายต่อการรักษาความสะอาด', 0, 2),
('1_3', 1, '1.3 พื้นที่ปฏิบัติงานและห้องเก็บรักษาสัตว์น้ำออกแบบอย่างเหมาะสม ถูกสุขลักษณะ ทำความสะอาดได้ง่าย และไม่ก่อให้เกิดการปนเปื้อน', 1, 3),
('1_4', 1, '1.4 มีพื้นที่เพียงพอและเหมาะสมสำหรับรับวัตถุดิบ การคัดเลือก การขนถ่าย และเก็บรักษาสัตว์น้ำ โดยจัดวางให้เป็นระเบียบและรักษาความสะอาด', 1, 4),
('1_5', 1, '1.5 พื้นที่ของเรือที่ปฏิบัติงานและห้องเก็บรักษาสัตว์น้ำทำจากวัสดุคงทน ผิวเรียบ ทำความสะอาดง่าย และไม่เป็นพิษต่อสัตว์น้ำ', 1, 5),
('1_6', 1, '1.6 พื้นที่ปฏิบัติงานและห้องเก็บรักษาสัตว์น้ำต้องทำความสะอาดทุกครั้งหลังการใช้งานด้วยน้ำสะอาด และมีระบบสุขาภิบาลที่เหมาะสม', 1, 6),
('1_7', 1, '1.7 จัดพื้นที่บริเวณเฉพาะสำหรับเก็บขยะ เศษอาหาร และเศษสัตว์น้ำที่เหลือให้เป็นสัดส่วน แยกออกจากบริเวณพื้นที่ปฏิบัติงานอย่างชัดเจน', 1, 7),
('2_1', 1, '2.1 วัสดุ อุปกรณ์และเครื่องมือที่ใช้ทำความสะอาดแล้วต้องมีที่เก็บอย่างเหมาะสม สามารถป้องกันการปนเปื้อน และรักษาความสะอาดของพื้นผิวที่สัมผัสสัตว์น้ำได้', 1, 1),
('2_2', 1, '2.2 วัสดุ อุปกรณ์และเครื่องมือทุกชนิดที่สัมผัสกับสัตว์น้ำต้องทำจากวัสดุที่มีผิวเรียบ ไม่มีรอยแตก ทำความสะอาดง่าย ไม่ดูดซับน้ำ และไม่เป็นสนิม', 0, 2),
('2_3', 1, '2.3 วัสดุ อุปกรณ์และเครื่องมือทุกชนิดต้องออกแบบให้เหมาะสมกับการใช้งานและสะดวกในการรักษาความสะอาด', 0, 3),
('2_4', 1, '2.4 วัสดุ อุปกรณ์และเครื่องมือทุกชนิดต้องล้างทำความสะอาดทุกครั้งหลังการใช้งานด้วยน้ำสะอาด (น้ำประปา)', 1, 4),
('2_5', 1, '2.5 ภาชนะที่บรรจุสัตว์น้ำมีสภาพแข็งแรง น้ำหนักเบา และสามารถรับน้ำหนักได้ในกรณีที่ต้องวางซ้อนกัน เพื่อป้องกันไม่ให้ภาชนะกดทับสัตว์น้ำ', 0, 5),
('2_6', 1, '2.6 ภาชนะที่บรรจุสัตว์น้ำควรมีรูหรือช่องระบายน้ำได้ดี เช่น ภาชนะพลาสติก', 1, 6),
('3_1', 1, '3.1 บุคลากรที่ปฏิบัติงานในเรือต้องมีสุขภาพดี ไม่มีโรคติดต่อ ไม่มีแผลเปิด และไม่มีพฤติกรรมที่ก่อให้เกิดการปนเปื้อนต่อสัตว์น้ำ', 1, 1),
('3_2', 1, '3.2 ผ่านการฝึกอบรมเรื่องสุขอนามัยที่ควรปฏิบัติในเรือประมง', 1, 2),
('3_3', 1, '3.3 ล้างมือให้สะอาดทั้งก่อนและหลังการปฏิบัติงานทุกครั้ง รวมทั้งในระหว่างการปฏิบัติงานตามความเหมาะสม และทุกครั้งหลังการใช้สุขา', 1, 3),
('3_4', 1, '3.4 เสื้อผ้าที่ใส่ทำงานต้องสะอาด และเหมาะสมกับการปฏิบัติงาน', 1, 4),
('3_5', 1, '3.5 ไม่รับประทานอาหารหรือสูบบุหรี่ ไม่ไอหรือจามใส่สัตว์น้ำขณะปฏิบัติงาน', 1, 5),
('4_1', 1, '4.1 น้ำจืด และน้ำแข็งที่ใช้สำหรับเก็บรักษาสัตว์น้ำต้องทำจากน้ำที่สะอาด และเพียงพอกับการใช้งาน', 1, 1),
('4_2', 1, '4.2 สถานที่เก็บ และภาชนะที่บรรจุน้ำจืด และน้ำแข็งต้องอยู่ในสภาพดี สะอาด ถูกสุขลักษณะ ทำด้วยวัสดุปลอดสนิมและทำความสะอาดได้ง่าย', 0, 2),
('4_3', 1, '4.3 มีการถ่ายเท ขนถ่ายน้ำจืดและน้ำแข็งอย่างถูกสุขลักษณะ น้ำแข็งลงเรือ', 1, 3),
('4_4', 1, '4.4 ภาชนะที่บรรจุน้ำจืด และน้ำแข็งต้องมีฝาปิดมิดชิด', 0, 4),
('5_1', 1, '5.1 น้ำยาทำความสะอาด น้ำยาฆ่าเชื้อ และยาฆ่าแมลง ต้องเก็บแยกในสถานที่ที่เป็นสัดส่วน ถูกสุขลักษณะ และควบคุมไม่ให้มีโอกาสปนเปื้อนในสัตว์น้ำได้', 0, 1),
('5_2', 1, '5.2 เก็บบรรจุสัตว์น้ำในภาชนะบรรจุที่แข็งแรง สะอาด และไม่ซ้อนทับจนทำให้สัตว์น้ำเสียหาย', 0, 2),
('5_3', 1, '5.3 เก็บรักษาสัตว์น้ำหลังจากการจับด้วยวิธีการที่เหมาะสมโดยเร็วที่สุด...', 1, 3),
('5_4', 1, '5.4 เก็บรักษาสัตว์น้ำอย่างถูกสุขลักษณะ และรักษาอุณหภูมิของสัตว์น้ำให้ใกล้เคียง 0 องศาเซลเซียส...', 1, 4),
('5_5', 1, '5.5 วางหรือเก็บรักษาสัตว์น้ำในที่เหมาะสม หากเป็นการแช่เย็นหรือแช่แข็งต้องหลีกเลี่ยงการสัมผัสความร้อนจากแสงแดด หรือความร้อนอื่น ๆ', 0, 5),
('5_6', 1, '5.6 มีบันทึกรายละเอียดของแหล่งจับหรือแหล่งที่มาของสัตว์น้ำ พร้อมเก็บไว้เพื่อการตรวจสอบ', 0, 6),
('5_7', 1, '5.7 ขนถ่ายสัตว์น้ำอย่างถูกสุขลักษณะ โดยหลีกเลี่ยงการใช้วัสดุอุปกรณ์ที่จะก่อให้เกิดความเสียหายแก่สัตว์น้ำ', 1, 7),
('5_8', 1, '5.8 ห้องเย็นเก็บรักษาสัตว์น้ำต้องสามารถควบคุมอุณหภูมิไม่สูงกว่า 18 องศาเซลเซียสและติดตั้งเทอร์โมมิเตอร์หรืออุปกรณ์บันทึกอุณหภูมิ อย่างต่อเนื่องอัตโนมัติ', 1, 8),
('5_9', 1, '5.9 กระบวนการทำความเย็นต้องมีประสิทธิภาพที่จะลดอุณหภูมิของสัตว์น้ำได้อย่างทั่วถึง และอุณหภูมิในสัตว์น้ำไม่สูงกว่า 18 องศาเซลเซียส', 1, 9),
('1_1', 2, '1.1 ห้องเก็บรักษาสัตว์น้ำต้องรักษาความสะอาด มีการบำรุงรักษาให้อยู่ในสภาพดี มีขนาดเหมาะสมเพียงพอ และป้องกันไม่ให้สัตว์น้ำปนเปื้อนกับน้ำท้องเรือประมง สิ่งปฏิกูล ควัน น้ำมันเชื้อเพลิง น้ำมันจาระบี หรือสิ่งสกปรกอื่นๆ ในกรณีขอรับหนังสือรับรอง สร.3 EU ฉบับชั่วคราว ต้องมีเครื่องยนต์พร้อมใช้งานอยู่ในเรือประมง', 1, 1),
('1_2', 2, '1.2 มีโครงสร้างอย่างเหมาะสมโดยมีส่วนที่เป็นซอกมุมน้อยที่สุด เพื่อให้ง่ายต่อการรักษาความสะอาด', 0, 2),
('1_3', 2, '1.3 พื้นที่ปฏิบัติงานออกแบบอย่างเหมาะสม ถูกสุขลักษณะ และไม่ก่อให้เกิดการปนเปื้อนจากน้ำท้องเรือประมง สิ่งปฏิกูล ควัน น้ำมันเชื้อเพลิง น้ำมันจาระบี หรือสิ่งสกปรกอื่นๆ ไปยังสัตว์น้ำ โดยต้องแยกจากส่วนที่เป็นเครื่องยนต์ของเรือประมง และที่พักอาศัยของลูกเรือประมงอย่างชัดเจน', 1, 3),
('1_4', 2, '1.4 มีพื้นที่เพียงพอและเหมาะสมสำหรับการรับวัตถุดิบ การคัดเลือก การขนถ่ายสัตว์น้ำ และเก็บรักษาสัตว์น้ำ ต้องรักษาความสะอาด มีการบำรุงรักษาให้อยู่ในสภาพดี และป้องกันไม่ให้ปนเปื้อนกับน้ำท้องเรือประมง สิ่งปฏิกูล ควัน น้ำมันเชื้อเพลิง น้ำมันจาระบี หรือสิ่งสกปรกอื่นๆ ไปยังสัตว์น้ำ', 1, 4),
('1_5', 2, '1.5 พื้นที่ผิวของเรือบริเวณที่ปฏิบัติงาน และห้องเก็บรักษาสัตว์น้ำ ทำจากวัสดุผิวเรียบ ที่สามารถทำความสะอาดได้ง่าย กรณีทาสีต้องดูแลไม่ให้สีหลุดร่อน สีที่ใช้ต้องคงทนและไม่เป็นพิษ', 1, 5),
('1_6', 2, '1.6 พื้นที่ปฏิบัติงานและห้องเก็บรักษาสัตว์น้ำ ต้องทำความสะอาดทุกครั้งหลังการใช้งานด้วยน้ำสะอาด ต้องไม่มีสัตว์เลี้ยงในเรือประมง และมีการควบคุม ป้องกัน กำจัดหนู แมลงสาบ และสัตว์อื่นที่เป็นพาหะนำโรค', 1, 6),
('1_7', 2, '1.7 จัดพื้นที่บริเวณเฉพาะสำหรับเก็บขยะ เศษอาหาร และเศษสัตว์น้ำที่เหลือให้เป็นสัดส่วน มีฝาปิดมิดชิด แยกออกจากบริเวณพื้นที่ปฏิบัติงาน', 1, 7),
('2_1', 2, '2.1 วัสดุ อุปกรณ์และเครื่องมือที่ล้างทำความสะอาดแล้วต้องมีที่เก็บอย่างเหมาะสม สามารถป้องกันไม่ให้เกิดการปนเปื้อน โดยเฉพาะพื้นผิวที่ต้องสัมผัสสัตว์น้ำ', 1, 1),
('2_2', 2, '2.2 วัสดุ อุปกรณ์และเครื่องมือทุกชนิดที่สัมผัสกับสัตว์น้ำต้องทำจากวัสดุที่มีผิวเรียบ ไม่มีรอยแตก ทำความสะอาดง่าย ไม่ดูดซับน้ำและไม่เป็นสนิม', 0, 2),
('2_3', 2, '2.3 วัสดุ อุปกรณ์และเครื่องมือทุกชนิดต้องมีความเหมาะสมกับการใช้งานและสะดวกในการรักษาความสะอาด', 0, 3),
('2_4', 2, '2.4 วัสดุ อุปกรณ์และเครื่องมือทุกชนิดต้องล้างทำความสะอาดทุกครั้งหลังการใช้งานด้วยน้ำสะอาด', 1, 4),
('2_5', 2, '2.5 ภาชนะที่บรรจุสัตว์น้ำมีสภาพแข็งแรง น้ำหนักเบา สามารถรับน้ำหนักได้ในกรณีที่ต้องวางซ้อนกัน เพื่อป้องกันไม่ให้ภาชนะกดทับสัตว์น้ำ สามารถป้องกันไม่ให้สัตว์น้ำปนเปื้นกับน้ำท้องเรือประมง สิ่งปฎิกูล ควัน น้ำมันเชื้อเพลิง น้ำมัน จาระบี หรือสิ่งสกปรกอื่น ๆ และห้ามนำไปใช้บรรจุสิ่งของอื่นนอกเหนือจากการเก็บรักษาสัตว์น้ำ', 0, 5),
('2_6', 2, '2.6 ภาชนะที่บรรจุสัตว์น้ำควรมีรูหรือช่องระบายน้ำได้ดี เช่น ภาชนะพลาสติก', 1, 6),
('3_1', 2, '3.1 บุคคลากรที่ปฏิบัติงานในเรือประมงต้องมีสุขภาพดี ไม่เป็นโรคติดต่อร้ายแรง ไม่เป็นพาหะของโรคทางเดินอาหาร และไม่มีแผลเปิดหรือแผลติดเชื้อ', 1, 1),
('3_2', 2, '3.2 ผ่านการฝึกอบรมหรือได้รับการถ่ายทอดความรู้เรื่องสุขอนามัยที่ควรปฏิบัติในเรือประมง', 1, 2),
('3_3', 2, '3.3 ล้างมือให้สะอาดทั้งก่อน ระหว่าง และหลังการปฏิบัติงานทุกครั้ง ตามความเหมาะสม และทุกครั้งหลังการใช้สุขา', 1, 3),
('3_4', 2, '3.4 เสื้อผ้าที่ใส่ทำงานต้องสะอาด และเหมาะสมกับการปฏิบัติงาน', 1, 4),
('3_5', 2, '3.5 ไม่รับประทานอาหารหรือสูบบุหรี่ และไม่ไอหรือจามใส่สัตว์น้ำขณะปฏิบัติงาน', 1, 5),
('4_1', 2, '4.1 น้ำจืด และน้ำแข็งที่ใช้สำหรับเก็บรักษาสัตว์น้ำต้องทำจากน้ำที่สะอาด และเพียงพอกับการใช้งาน', 1, 1),
('4_2', 2, '4.2 การจัดเก็บน้ำจืด น้ำใช้ และน้ำแข็งต้องมีการป้องกัน หรืออยู่ในสถานที่ที่หลีกเลี่ยงการปนเปื้อน', 0, 2),
('4_3', 2, '4.3 มีการลำเลียง ขนถ่ายน้ำจืดและน้ำแข็งอย่างถูกสุขลักษณะ', 1, 3),
('4_4', 2, '4.4 ภาชนะที่บรรจุน้ำจืด น้ำใช้ และน้ำแข็งต้องมีฝาปิดมิดชิดเพื่อป้องกันไม่ให้เกิดการปนเปื้อน อยู่ในสภาพดี สะอาด ถูกสุขลักษณะ ทำด้วยวัสดุปลอดสนิม และทำความสะอาดได้ง่าย', 0, 4),
('5_1', 2, '5.1 น้ำยาทำความสะอาด น้ำยาฆ่าเชื้อ และยาฆ่าแมลง ต้องเก็บแยกในสถานที่ที่เป็นสัดส่วน ถูกสุขลักษณะ และควบคุมไม่ให้มีโอกาสปนเปื้อนในสัตว์น้ำได้', 0, 1),
('5_2', 2, '5.2 เก็บ บรรจุสัตว์น้ำในภาชนะบรรจุที่แข็งแรง สะอาด และไม่ซ้อนทับจนทำให้สัตว์น้ำเสียหาย', 0, 2),
('5_3', 2, '5.3 เก็บรักษาสัตว์น้ำด้วยน้ำแข็ง และต้องรักษาอุณหภูมิของสัตว์น้ำ ให้ได้ความเย็นอย่างสม่ำเสมอทั่วทั้งภาชนะเก็บสัตว์น้ำ', 1, 3),
('5_4', 2, '5.4 เก็บรักษาสัตว์น้ำอย่างถูกสุขลักษณะ และรักษาอุณหภูมิของสัตว์น้ำให้ใกล้เคียง 0 องศาเซลเซียส สำหรับสัตว์น้ำสด', 1, 4),
('5_5', 2, '5.5 วางหรือเก็บรักษาสัตว์น้ำในที่เหมาะสม และต้องหลีกเลี่ยงการสัมผัสความร้อนจากแสงแดด หรือความร้อนอื่น ๆ', 0, 5),
('5_6', 2, '5.6 มีบันทึกรายละเอียดของแหล่งจับหรือแหล่งที่มาของสัตว์น้ำ พร้อมเก็บไว้เพื่อการตรวจสอบ', 0, 6),
('5_7', 2, '5.7 ขนถ่ายสัตว์น้ำอย่างถูกสุขลักษณะ โดยหลีกเลี่ยงการใช้วัสดุอุปกรณ์ที่จะก่อให้เกิดความเสียหายแก่สัตว์น้ำ', 1, 7),
('5_8', 2, '5.8 ห้องเย็นเก็บรักษาสัตว์น้ำต้องสามารถควบคุมอุณหภูมิไม่สูงกว่า 18 องศาเซลเซียสและติดตั้งเทอร์โมมิเตอร์หรืออุปกรณ์บันทึกอุณหภูมิ อย่างต่อเนื่องอัตโนมัติ', 1, 8),
('5_9', 2, '5.9 กระบวนการทำความเย็นต้องมีประสิทธิภาพที่จะลดอุณหภูมิของสัตว์น้ำได้อย่างทั่วถึง และอุณหภูมิในสัตว์น้ำไม่สูงกว่า 18 องศาเซลเซียส', 1, 9);